pipeline {
    agent any

    stages {
        stage('Unit Tests - Backend') {
            agent {
              // This is a docker image created by the instructor that has everything the unit tests need in order to run such as "go-lang"
              docker {
                image 'snakee/golang-junit:1.21'
                reuseNode true // Ensure this image is used throughout the Jenkins pipeline
                args '-u root' // Run as root so Go can write to /go and /.cache inside the container (local dev only). In a real CI environment, this issue would be solved at the Docker image level, not here like this
              }
            }
            // "steps" are your terminal commands needed to run the unit tests
            steps {
                dir('bugtracker-backend') {
                  sh 'go test -v ./... 2>&1 | go-junit-report > test-results.xml' // Same terminal command you would use to run locally (sh means "shell command")
                }
            }
            post{
              always {
                junit 'bugtracker-backend/test-results.xml'
              }
            }
        }
        stage('Unit Tests - Frontend') {
          agent {
            docker {
              image 'node:20-alpine'
              reuseNode true
            }
          }
            steps {
              // The 3 single quotes wrapping the shell commands allow you to have to type "sh" only once. The shell commands are: install dependencies (ci) followed by running the tests.
              dir('bugtracker-frontend'){
                sh '''
                  npm ci
                  npm test
                '''
              }
          }
          // The "post" positioning MUST be after all of the "steps"
          post {
            // "always" means this will run regardless of the build being successful or not
            always {
              junit 'bugtracker-frontend/test-results.xml'
            }
          }
        }
    }
}